# Required for the default AI planner and image grader.
# Each user supplies their own API key and API credits.
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]

# Optional: required only when --sources includes google.
# GOOGLE_API_KEY=[YOUR_GOOGLE_API_KEY]
# GOOGLE_CSE_ID=[YOUR_GOOGLE_SEARCH_ENGINE_ID]

# Optional: increase Openverse's anonymous request limit.
# OPENVERSE_TOKEN=[YOUR_OPENVERSE_TOKEN]

# Optional: required only with --provider anthropic.
# Also install its SDK: python -m pip install 'anthropic>=0.40'
# ANTHROPIC_API_KEY=[YOUR_ANTHROPIC_API_KEY]
