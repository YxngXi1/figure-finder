# Required API credentials
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]
BRAVE_API_KEY=[YOUR_BRAVE_API_KEY]

# Required by the web app
FF_WEB_PASSWORD=[CHOOSE_A_LONG_SHARED_PASSWORD]

# Production web settings. Render can generate FF_WEB_SESSION_SECRET for you.
FF_WEB_SESSION_SECRET=[GENERATE_A_RANDOM_SECRET]
FF_WEB_SECURE_COOKIES=0
FF_WEB_DAILY_SEARCH_LIMIT=40
FF_WEB_SEARCH_COOLDOWN_SECONDS=10

# Optional model/provider overrides
FF_PROVIDER=openai
FF_PLANNER_MODEL=gpt-4.1-mini
FF_SCORER_MODEL=gpt-4.1-mini
FF_JUDGE_MODEL=gpt-4.1-mini


# --- PRIVATE GOOGLE SLIDES AGENT ---
# Existing API keys above are reused. OAuth credentials stay in a separate JSON file.

# Download the Desktop app OAuth JSON from Google Cloud and save it at this path.
FF_GOOGLE_CREDENTIALS=.secrets/google-oauth.json

# Created automatically after Google sign-in. Leave this path as-is; do not paste a token.
FF_GOOGLE_TOKEN=.secrets/google-token.json

# PASTE YOUR TEST DECK URL after the equals sign below (use a deck you can edit).
FF_GOOGLE_PRESENTATION=
